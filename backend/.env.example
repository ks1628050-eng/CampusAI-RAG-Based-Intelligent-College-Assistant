PORT=5000
NODE_ENV=development
JWT_SECRET=campus_ai_super_secret_jwt_key_2026

# Optional: MongoDB Atlas Cloud Database Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campus_ai?retryWrites=true&w=majority
# If omitted or left as placeholder, the system runs seamlessly on the local persistent store!
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campus_ai?retryWrites=true&w=majority

# Optional: Google Gemini API Key for text-embedding-004 and Gemini 1.5/2.0 generation
# If left empty, system automatically uses built-in semantic vector retrieval & synthesizer!
GEMINI_API_KEY=your_gemini_api_key_here
